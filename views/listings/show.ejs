<% layout("/layouts/boilerplate") %>
<div class="show-wrap">
   <h3 class="mb-1"><%= listing.title %></h3>
   <p class="show-meta">
      <i class="fa-solid fa-location-dot"></i>
      <%= listing.location %><%= listing.country ? ", " + listing.country : "" %>
   </p>

   <img src="<%= listing.image.url %>" class="show-img" alt="<%= listing.title %>">

   <div class="row mt-4">
      <div class="col-md-8">
         <div class="owner-badge mb-3">
            <i class="fa-regular fa-circle-user"></i>
            Hosted by <b><%= listing.owner.username %></b>
         </div>
         <p><%= listing.description %></p>
      </div>
      <div class="col-md-4">
         <p class="show-price">&#8377; <%= listing.price ?
            listing.price.toLocaleString("en-IN") :"N/A" %> <span>/ night</span></p>

         <% if(currUser && listing.owner._id.equals(currUser._id)){%>
         <div class="btns">
            <a href="/listings/<%=listing._id%>/edit" class="btn edit-btn">
               <i class="fa-regular fa-pen-to-square"></i> Edit</a>
            <form method="POST" action="/listings/<%=listing._id%>?_method=DELETE">
               <button class="btn btn-outline-dark">
                  <i class="fa-regular fa-trash-can"></i> Delete</button>
            </form>
         </div>
         <%}%>
      </div>
   </div>

   <hr class="my-4">

   <% if(currUser){%>
   <h4>Leave a Review</h4>
   <form action="/listings/<%= listing.id %>/reviews"
       method="POST"
       novalidate
       class="needs-validation mb-4">

      <div class="mb-3 mt-3">
         <label for="rating" class="form-label">Rating</label>
         <fieldset class="starability-slot">
            <input type="radio" id="no-rate"
              class="input-no-rate"
              name="review[rating]" value="1"
              checked aria-label="No rating." />

            <input type="radio" id="first-rate1" name="review[rating]" value="1" />
            <label for="first-rate1" title="Terrible">1 star</label>
            <input type="radio" id="first-rate2" name="review[rating]" value="2" />
            <label for="first-rate2" title="Not good">2 stars</label>
            <input type="radio" id="first-rate3" name="review[rating]" value="3" />
            <label for="first-rate3" title="Average">3 stars</label>
            <input type="radio" id="first-rate4" name="review[rating]" value="4" />
            <label for="first-rate4" title="Very good">4 stars</label>
            <input type="radio" id="first-rate5" name="review[rating]" value="5" />
            <label for="first-rate5" title="Amazing">5 stars</label>
         </fieldset>
      </div>
      <div class="mb-3">
         <label for="comment" class="form-label">Comments</label>
         <textarea
          name="review[comment]"
          id="comment"
          rows="4"
          class="form-control"
          placeholder="Share your experience..."
          required></textarea>
         <div class="invalid-feedback">
            Please add some comments for review
         </div>
      </div>
      <button class="btn btn-dark">Submit</button>
   </form>
   <%}%>

   <h4 class="mb-3">
      <i class="fa-solid fa-star" style="color: var(--brand)"></i>
      <%= listing.reviews.length %> Review<%= listing.reviews.length === 1 ? "" : "s" %>
   </h4>

   <% if(!listing.reviews.length){ %>
      <p class="text-muted">No reviews yet. Be the first to review!</p>
   <% } %>

   <div class="row row-cols-1 row-cols-md-2 g-3">
      <% for (let review of listing.reviews){ %>
      <div class="col">
         <div class="card review-card">
            <div class="card-body">
               <h5 class="card-title">@<%= review.author.username %></h5>
               <p class="starability-result card-text" data-rating="<%= review.rating %>"></p>
               <p class="card-text"><%= review.comment %></p>

               <% if(currUser && review.author._id.equals(currUser._id)){ %>
               <form
                   method="POST"
                   action="/listings/<%=listing._id%>/reviews/<%=review._id%>?_method=DELETE">
                 <button class="btn btn-sm btn-outline-dark">Delete</button>
               </form>
               <% } %>
            </div>
         </div>
      </div>
      <%}%>
   </div>
</div>
