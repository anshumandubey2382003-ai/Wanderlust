<% layout("/layouts/boilerplate") %>
    <style>
#filters {
  display: flex;
  align-items: center;
  gap: 2rem;
  padding: 1rem 0 0.5rem;
  margin-bottom: 1.5rem;
  border-bottom: 1px solid var(--border);
  overflow-x: auto;        /* mobile scroll */
  scrollbar-width: none;  /* firefox */
}

#filters::-webkit-scrollbar {
  display: none;           /* chrome */
}

.filter {
  min-width: 70px;
  text-align: center;
  opacity: 0.6;
  flex-shrink: 0;          /* important for scroll */
  padding-bottom: 0.5rem;
  border-bottom: 2px solid transparent;
  transition: opacity 0.2s, border-color 0.2s;
}

.filter:hover {
  opacity: 1;
  cursor: pointer;
  border-bottom-color: var(--border);
}

.filter i {
  font-size: 1.3rem;
}

.filter p {
  font-size: 0.75rem;
  font-weight: 600;
  margin: 0.4rem 0 0;
}

/* TAX TOGGLE */
.tax-toggle {
  flex-shrink: 0;
  border: 1px solid var(--border);
  border-radius: 0.8rem;
  padding: 0.7rem 1rem;
  display: flex;
  align-items: center;
  margin-left: auto;   /* push to right */
  font-size: 0.85rem;
  white-space: nowrap;
}

/* MOBILE ONLY */
@media (max-width: 600px) {
  .tax-toggle {
    margin-left: 0;
  }

  /* 2 cards per row: chhote cards */
  .listing-card {
    margin-bottom: 0.5rem;
  }

  .listing-card .img-wrap {
    border-radius: 0.7rem;
  }

  .listing-card .card-img-top {
    height: 9.5rem;
  }

  .listing-card .card-body {
    padding: 0.5rem 0.1rem 0 !important;
  }

  .listing-title {
    font-size: 0.85rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .listing-location {
    font-size: 0.75rem;
    margin-bottom: 0.15rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .listing-price {
    font-size: 0.8rem;
    margin-bottom: 0;
  }

  .tax-info {
    font-size: 0.7rem;
  }
}
    </style>

    <div id="filters">
      <div class="filter">
        <div><i class="fa-solid fa-fire"></i></div>
        <p>Trending</p>
      </div>
       <div class="filter">
        <div><i class="fa-solid fa-bed"></i></div>
        <p>Room</p>
      </div>
       <div class="filter">
        <div><i class="fa-solid fa-city"></i></div>
        <p>Iconic Cities</p>
      </div>
       <div class="filter">
        <div><i class="fa-solid fa-mountain"></i></div>
        <p>Mountains</p>
      </div>
       <div class="filter">
        <div><i class="fa-brands fa-fort-awesome"></i></div>
        <p>Castles</p>
      </div>
       <div class="filter">
        <div><i class="fa-solid fa-person-swimming"></i></div>
        <p>Amazing Pools</p>
      </div>
       <div class="filter">
        <div><i class="fa-solid fa-campground"></i></div>
        <p>Camping</p>
      </div>
       <div class="filter">
        <div><i class="fa-solid fa-cow"></i></div>
        <p>Farms</p>
      </div>
       <div class="filter">
        <div><i class="fa-regular fa-snowflake"></i></div>
        <p>Arctic</p>
      </div>
        <div class="filter">
        <div><i class="fa-solid fa-igloo"></i></div>
        <p>Dome</p>
      </div>
        <div class="filter">
        <div><i class="fa-solid fa-ship"></i></div>
        <p>Boats</p>
      </div>

      <div class="tax-toggle">
        <div class="form-check-reverse form-switch">
          <input class="form-check-input"
          type="checkbox"
          role="switch"
          id="flexSwitchCheckDefault">
          <label class="form-check-label" for="flexSwitchCheckDefault">
            Display total after taxes</label>
        </div>
      </div>
    </div>

    <% if(search){ %>
      <p class="text-muted">Showing results for "<b><%= search %></b>" &middot; <a href="/listings" class="text-dark">Clear</a></p>
    <% } %>

    <% if(!allListings.length){ %>
      <div class="empty-state">
        <i class="fa-solid fa-magnifying-glass"></i>
        <h5>No listings found</h5>
        <p>Try searching for a different destination.</p>
      </div>
    <% } %>

    <div class="row row-cols-lg-3 row-cols-2 g-3 g-md-4">
        <% for(let listing of allListings ){ %>
          <a href="/listings/<%= listing._id%>" class="listing-link">
            <div class="card col listing-card">
              <div class="img-wrap">
                <img src="<%= listing.image.url %>"
                    class="card-img-top" alt="<%= listing.title %>">
              </div>
              <div class="card-body">
                <p class="listing-title"><%= listing.title %></p>
                <p class="listing-location">
                  <%= listing.location %><%= listing.country ? ", " + listing.country : "" %></p>
                <p class="listing-price">
                  <b>&#8377; <%= listing.price ?
                     listing.price.toLocaleString("en-IN") :"N/A" %></b> / night
                  <span class="tax-info">&nbsp;+18% GST</span>
                </p>
              </div>
           </div>
         </a>
        <%}%>
    </div>

<script>
  let taxSwitch=document.getElementById("flexSwitchCheckDefault");
  taxSwitch.addEventListener("change" ,() => {
    let taxInfo = document.getElementsByClassName("tax-info");
    for(let info of taxInfo){
      info.style.display = taxSwitch.checked ? "inline" : "none";
    }
  });
</script>
